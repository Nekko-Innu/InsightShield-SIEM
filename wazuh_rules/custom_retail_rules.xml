<!--
  custom_retail_rules.xml
  Insight Shield — Wazuh Custom Rules for Southern's Twin Supermart (Lipa Branch)
  Covers: POS Malware, MitM, Unauthorized Access, Ransomware (FIM), DoS

  INSTALLATION: scripts/install.sh §7 copies this file to
    /var/ossec/etc/rules/, validates it with `wazuh-analysisd -t` and restarts
    the manager only if it compiles. It also installs wazuh_rules/agent.conf,
    which the Sysmon, FIM and victim-side rules (100023, 100031) depend on.

  Every <if_sid> parent is a stock Wazuh 4.8.2 rule, checked against the
  v4.8.2 ruleset source (tests/test_mitm_rules.py pins the list).

  DESCRIPTIONS: "Insight Shield: <what happened> — <facts>". The level sets
  severity, so no "CRITICAL —" prefix. Facts come from short $(fields); at most
  one path per rule, never a command line. FIM rules name no file: they fire
  once per file, and the translation cache is keyed on the description, so a
  per-file description would buy one AI call per encrypted file. The path is
  in the alert's attack trail.

  <time> WINDOWS are read in UTC. The host clock is PHT (Suricata stamps
  +0800, systemd prints PST), but wazuh-analysisd sees UTC — its alerts are
  stamped +0000 — and <time> is checked against analysisd's clock. Every
  window below is PHT minus 8 h: business hours 08:00-21:00 PHT = 00:00-13:00
  UTC. Written in PHT they fired 8 hours off: "after hours" landed on
  05:00-16:00 PHT (100002 fired at 15:37 PHT). If alerts.json timestamps
  ever start ending in +0800, analysisd has picked up the host zone and
  these must go back to PHT.

  RULE LEVEL MAPPING TO INSIGHT SHIELD SEVERITY TIERS:
    Level  2-4  → Informational
    Level  5-7  → Low
    Level  8-9  → Medium
    Level 10-12 → High
    Level 13-15 → Critical
-->

<group name="insightshield_retail">

  <!-- ═══════════════════════════════════════════════════════
       CATEGORY 1 — UNAUTHORIZED ACCESS
       Primary: Brute-force login, after-hours access, new admin account
       Windows Events: 4625 (failed login), 4672 (admin logon), 4720 (new account)
       ═══════════════════════════════════════════════════════ -->

  <!-- Multiple failed logins on POS terminal — brute force attempt.
       No no_log: it kept the alert out of alerts.json, so the integrator
       never saw it and the dashboard never showed a brute force. -->
  <rule id="100001" level="10" frequency="6" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <field name="win.system.eventID">^4625$</field>
    <description>Insight Shield: Repeated failed logins, possible brute force — from $(win.eventdata.ipAddress)</description>
    <group>insightshield_unauthorized,authentication_failed,</group>
  </rule>

  <!-- Privileged account logon outside business hours (before 8AM or after 9PM
       PHT; 13:00-00:00 UTC, see the header) -->
  <!-- SYSTEM / LOCAL SERVICE / NETWORK SERVICE get a 4672 on every service
       start; without the negate this fires all night. -->
  <rule id="100002" level="10">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4672$</field>
    <field name="win.eventdata.subjectUserSid" type="pcre2" negate="yes">^S-1-5-(18|19|20)$</field>
    <time>13:00 - 00:00</time>
    <description>Insight Shield: Admin login outside business hours — account $(win.eventdata.subjectUserName)</description>
    <group>insightshield_unauthorized,authentication_success,after_hours,</group>
  </rule>

  <!-- New user account created unexpectedly -->
  <rule id="100003" level="12">
    <if_sid>60109</if_sid>
    <field name="win.system.eventID">^4720$</field>
    <description>Insight Shield: New user account created — $(win.eventdata.targetUserName), by $(win.eventdata.subjectUserName)</description>
    <group>insightshield_unauthorized,account_management,</group>
  </rule>

  <!-- Account added to privileged group (Administrators) -->
  <rule id="100004" level="12">
    <if_sid>60154</if_sid>
    <field name="win.system.eventID">^4732$</field>
    <description>Insight Shield: Account added to the Administrators group — by $(win.eventdata.subjectUserName)</description>
    <group>insightshield_unauthorized,account_management,privilege_escalation,</group>
  </rule>

  <!-- ═══════════════════════════════════════════════════════
       CATEGORY 2 — POS MALWARE / RAM SCRAPING
       Primary: Process injection into POS, FIM on POS dirs, new service install
       Requires: Microsoft Sysmon with ProcessAccess (Event 10) logged for the
                 POS and lsass.exe images, and the Sysmon channel collected
                 (wazuh_rules/agent.conf).
       Windows Events: 4688 (new process), 7045 (new service), 4663 (file access)
       ═══════════════════════════════════════════════════════ -->

  <!-- Sysmon: Process accessing POS terminal memory — RAM scraping indicator.
       No MITRE tag: none exists for POS RAM scraping, and a guessed one is
       worse than none. -->
  <rule id="100010" level="15">
    <if_sid>61612</if_sid>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.system.eventID">^10$</field>
    <field name="win.eventdata.targetImage" type="pcre2">pos_terminal|cashier|payment|pos\.exe</field>
    <description>Insight Shield: Another program read the POS program's memory, card data theft suspected — $(win.eventdata.sourceImage)</description>
    <group>insightshield_pos_malware,ram_scraping,critical,</group>
  </rule>

  <!-- FIM: Unauthorized change detected in POS application directory -->
  <rule id="100011" level="13">
    <if_sid>554,550</if_sid>
    <field name="file" type="pcre2">C:\\POS|C:\\cashier|C:\\payment</field>
    <description>Insight Shield: POS program files changed — malware suspected</description>
    <group>insightshield_pos_malware,file_integrity,</group>
  </rule>

  <!-- FIM: New executable file written to POS directory -->
  <rule id="100012" level="14">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">\.exe$|\.dll$|\.bat$|\.ps1$</field>
    <field name="file" type="pcre2">C:\\POS|C:\\cashier|C:\\Temp</field>
    <description>Insight Shield: New program dropped into a POS folder — malware installation suspected</description>
    <group>insightshield_pos_malware,file_integrity,critical,</group>
  </rule>

  <!-- New Windows service installed on POS terminal -->
  <rule id="100013" level="13">
    <if_sid>61138</if_sid>
    <field name="win.system.eventID">^7045$</field>
    <description>Insight Shield: New Windows service installed, possible malware persistence — $(win.eventdata.serviceName)</description>
    <group>insightshield_pos_malware,malware,</group>
  </rule>

  <!-- Suspicious new process created on POS terminal. Path only: matching
       cmd.exe/powershell.exe anywhere fired every 10 s on the agent's own
       command monitors (agent.conf runs them through SysWOW64\cmd.exe), and
       on every admin script. psexec-style remote execution is 100013.
       OneDrive is excluded: it installs and updates itself under
       AppData\Local\Microsoft\OneDrive, so every sync raised a HIGH. \\+ not
       \\: eventchannel fields can carry the path with doubled backslashes,
       and a single-backslash pattern then never matches. -->
  <rule id="100014" level="10">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4688$</field>
    <field name="win.eventdata.newProcessName" type="pcre2">\\Temp\\|\\AppData\\</field>
    <field name="win.eventdata.newProcessName" negate="yes" type="pcre2">Microsoft\\+OneDrive</field>
    <description>Insight Shield: Program launched from an unusual place — $(win.eventdata.newProcessName)</description>
    <group>insightshield_pos_malware,execution,</group>
  </rule>

  <!-- ═══════════════════════════════════════════════════════
       CATEGORY 3 — MAN-IN-THE-MIDDLE (MitM) / ARP POISONING
       100020-100022: arpwatch on the Wazuh manager's LAN interface, logging to
                 syslog. Wazuh's stock arpwatch rules (7200 group) decode it;
                 these three escalate. Without arpwatch — or when the manager
                 cannot see POS traffic — they never fire.
       100023: victim side, needs no network visibility. Works on any LAN.
       These once hung off 5402/5403/5404 — the stock SUDO rules, not ARP —
       so every root sudo raised a CRITICAL "ARP poisoning" alert.
       ═══════════════════════════════════════════════════════ -->

  <!-- 7204 IP moved to a new MAC, 7209 possible arpspoofing.
       ignore="600": once per 10 minutes, not once per packet. arpspoof
       re-poisons every 2 s and arpwatch logs each reply, so one 30-second
       spoof stored ~60 CRITICAL rows. For 10 minutes after firing, Wazuh
       reports the event under the parent instead (7204/7209, overwritten
       below to informational). A second attack inside that window is
       recorded, not re-alerted. -->
  <rule id="100020" level="14" ignore="600">
    <if_sid>7204,7209</if_sid>
    <description>Insight Shield: Known network address now answers from a different device — ARP spoofing (man-in-the-middle) suspected</description>
    <group>insightshield_mitm,arp_spoofing,critical,</group>
  </rule>

  <!-- 7202 "flip flop": IP alternating between two MACs. A live spoof
       alternates the real and the forged MAC, so this floods exactly like
       100020 — same ignore window, same informational parent below. -->
  <rule id="100021" level="12" ignore="600">
    <if_sid>7202</if_sid>
    <description>Insight Shield: One network address flipping between two devices — duplicate IP, possible man-in-the-middle</description>
    <group>insightshield_mitm,arp_spoofing,</group>
  </rule>

  <!-- 7201 new host. arpwatch cannot see an ARP scan itself; a never-seen
       device is the closest precursor it reports. -->
  <rule id="100022" level="10">
    <if_sid>7201</if_sid>
    <description>Insight Shield: Never-seen device appeared on the branch network — possible attacker mapping the network</description>
    <group>insightshield_mitm,reconnaissance,</group>
  </rule>

  <!-- Gateway MAC changed on this PC. Agent command alias 'arp-gateway'
       (wazuh_rules/agent.conf). Same shape as stock 533: 530 + the alias with
       no closing quote (a prefix match) + check_diff. Also fires once when the
       entry is restored. -->
  <rule id="100023" level="12">
    <if_sid>530</if_sid>
    <match>ossec: output: 'arp-gateway</match>
    <check_diff />
    <description>Insight Shield: Gateway address on this PC now points to a different device — ARP spoofing (man-in-the-middle) suspected</description>
    <group>insightshield_mitm,arp_spoofing,victim_side,</group>
  </rule>

  <!-- The stock arpwatch parents, lowered to level 3 (Informational). They only
       surface while 100020/100021 sit in their ignore window: those rules have
       no conditions of their own, so outside the window they claim every such
       event. Inside it, stock levels were 7204/7202 = 9 (MEDIUM — sent as HIGH
       after hours, -5 health score each) and 7209 = 7. At level 3 the repeats
       stay as evidence — stored, auto-closed, no notification, no score cost.
       Copied from stock v4.8.2 0115-arpwatch_rules.xml; only level and
       description differ. overwrite keeps the original if_sid regardless, and
       the stock groups are restated because this file's wrapper group would
       otherwise stand in for syslog,arpwatch. -->
  <rule id="7202" level="3" overwrite="yes">
    <if_sid>7200</if_sid>
    <match>flip flop </match>
    <description>Arpwatch: "flip flop" repeated while ARP spoofing is already alerted (100021)</description>
    <group>syslog,arpwatch,ip_spoof,pci_dss_1.3.4,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.a.1,nist_800_53_CA.3,nist_800_53_SI.4,tsc_CC6.6,tsc_CC6.7,tsc_CC6.8,tsc_CC7.1,tsc_CC6.1,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <rule id="7204" level="3" overwrite="yes">
    <if_sid>7200</if_sid>
    <match>changed ethernet address </match>
    <description>Arpwatch: address change repeated while ARP spoofing is already alerted (100020)</description>
    <group>syslog,arpwatch,ip_spoof,pci_dss_1.3.4,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.a.1,nist_800_53_CA.3,nist_800_53_SI.4,tsc_CC6.6,tsc_CC6.7,tsc_CC6.8,tsc_CC7.1,tsc_CC6.1,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <rule id="7209" level="3" overwrite="yes">
    <if_sid>7200</if_sid>
    <match>ethernet mismatch</match>
    <description>Arpwatch: ethernet mismatch repeated while ARP spoofing is already alerted (100020)</description>
    <mitre>
      <id>T1095</id>
    </mitre>
    <group>syslog,arpwatch,ip_spoof,pci_dss_1.3.4,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.a.1,nist_800_53_CA.3,nist_800_53_SI.4,tsc_CC6.6,tsc_CC6.7,tsc_CC6.8,tsc_CC7.1,tsc_CC6.1,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- ═══════════════════════════════════════════════════════
       CATEGORY 4 — RANSOMWARE (MITRE T1486: Data Encrypted for Impact)
       Primary: Wazuh File Integrity Monitoring (syscheck) on POS shared folders
       Detection: mass file-modification events + rename-with-new-extension storms
       Requires: realtime syscheck on C:\POS\shared (wazuh_rules/agent.conf).
       ═══════════════════════════════════════════════════════ -->

  <!-- Single FIM modification inside the POS shared folder — baseline event -->
  <rule id="100044" level="8">
    <if_sid>554,550</if_sid>
    <field name="file" type="pcre2">C:\\POS\\shared|/mnt/pos_share</field>
    <description>Insight Shield: File changed in the POS shared folder — watch for a larger pattern</description>
    <group>insightshield_ransomware,file_integrity,syscheck,</group>
  </rule>

  <!-- Suspicious new extension appended to files — common ransomware IoC -->
  <rule id="100045" level="12">
    <if_sid>554,550</if_sid>
    <field name="file" type="pcre2">\.(encrypted|locked|crypt|enc|ryk|pay|wcry)$</field>
    <description>Insight Shield: File renamed with a ransomware-style extension — encryption suspected</description>
    <group>insightshield_ransomware,file_integrity,t1486,</group>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

  <!-- Burst of FIM modifications in a short window — encryption storm -->
  <rule id="100046" level="14" frequency="20" timeframe="60">
    <if_matched_sid>100044</if_matched_sid>
    <description>Insight Shield: 20+ file changes in 60 seconds in the POS shared folder — ransomware encryption suspected</description>
    <group>insightshield_ransomware,file_integrity,encryption_storm,critical,</group>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

  <!-- Sustained rename-with-new-extension pattern — confirmed ransomware -->
  <rule id="100047" level="15" frequency="10" timeframe="120">
    <if_matched_sid>100045</if_matched_sid>
    <description>Insight Shield: 10+ ransomware-style renames in 2 minutes — encryption confirmed, isolate the PC now</description>
    <group>insightshield_ransomware,file_integrity,t1486,critical,</group>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

  <!-- ═══════════════════════════════════════════════════════
       CATEGORY 5 — DENIAL OF SERVICE (DoS) AND NETWORK SCANS
       100030/100040: Suricata on the manager, eve.json read by Wazuh (stock
                 86601 "Suricata: Alert"). The msg prefixes below are the two
                 Insight Shield rules in Suricata's local.rules
                 (docs/deployment-ubuntu.md) — rename one there, rename it
                 here. Silent when the manager cannot see POS traffic.
       100031: victim side, needs no network visibility.
       Windows Events: 7034 (service crashed), 7036 (service changed state)
       ═══════════════════════════════════════════════════════ -->

  <!-- Suricata "InsightShield port scan" (SYNs from one source to many ports) -->
  <rule id="100030" level="8">
    <if_sid>86601</if_sid>
    <field name="alert.signature">^InsightShield port scan</field>
    <description>Insight Shield: Port scan — from $(src_ip) against $(dest_ip)</description>
    <group>insightshield_recon,port_scan,</group>
  </rule>

  <!-- SYN flood on this PC. Agent command alias 'syn-watch' prints
       SYN_FLOOD_SUSPECTED or ok. ONE <match> only: Wazuh joins multiple <match>
       tags into one pattern, so the second condition must be a <regex> (as
       stock 531 does). check_diff because the agent sends the output every
       interval, not only on change — without it this fires every 10 s for the
       whole flood. -->
  <rule id="100031" level="12">
    <if_sid>530</if_sid>
    <match>ossec: output: 'syn-watch</match>
    <regex>SYN_FLOOD_SUSPECTED</regex>
    <check_diff />
    <description>Insight Shield: Flood of half-open connections on this PC — SYN flood (denial of service) in progress</description>
    <group>insightshield_dos,flood,victim_side,</group>
  </rule>

  <!-- Suricata "InsightShield SYN flood". Once hung off 31151, a web-log 400
       rule, so it never saw a flood. Destination only: a flood's sources are
       often random. -->
  <rule id="100040" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature">^InsightShield SYN flood</field>
    <description>Insight Shield: Flood of connection requests (SYN flood) — against $(dest_ip)</description>
    <group>insightshield_dos,flood,</group>
  </rule>

  <!-- Sustained flood after initial detection — escalate severity -->
  <rule id="100041" level="12" frequency="3" timeframe="60">
    <if_matched_sid>100040</if_matched_sid>
    <description>Insight Shield: Connection flood keeps going — denial of service in progress against $(dest_ip)</description>
    <group>insightshield_dos,flood,sustained,</group>
  </rule>

  <!-- POS or critical service crashed — possible result of DoS -->
  <rule id="100042" level="12">
    <!-- 7031 is caught first by stock 61107, 7034 goes straight to 61102 -->
    <if_sid>61102,61107</if_sid>
    <field name="win.system.eventID">^7031$|^7034$</field>
    <description>Insight Shield: Service crashed — $(win.eventdata.param1)</description>
    <group>insightshield_dos,insightshield_pos_malware,service_crash,</group>
  </rule>

  <!-- POS service stopped during business hours. 7036 fires for every service
       start/stop, so this is scoped to POS services and to "stopped" — 100051
       takes "running"; with identical conditions one of the two never fired. -->
  <rule id="100043" level="10">
    <if_sid>61100</if_sid>
    <field name="win.system.eventID">^7036$</field>
    <field name="win.eventdata.param1" type="pcre2">(?i)pos|cashier|payment</field>
    <field name="win.eventdata.param2">stopped</field>
    <time>00:00 - 13:00</time>
    <description>Insight Shield: POS service stopped during business hours — $(win.eventdata.param1)</description>
    <group>insightshield_dos,service_crash,</group>
  </rule>

  <!-- ═══════════════════════════════════════════════════════
       CATEGORY 6 — BASELINE / INFORMATIONAL (retail business hours)
       Low-noise events that prove the monitoring pipeline is alive
       without generating real incidents. Exercises INFO/LOW tiers.
       Group tag `insightshield_retail_baseline` lets the dashboard filter
       these out of the incident feed with a single URL parameter.
       ═══════════════════════════════════════════════════════ -->

  <!-- Successful interactive login during business hours — baseline cashier activity -->
  <!-- Stock 60118 (interactive logon) and 60119 (first-time user) sit under
       60106 with no eventID filter and match first, so hang off them too. -->
  <rule id="100050" level="3">
    <if_sid>60106,60118,60119</if_sid>
    <field name="win.system.eventID">^4624$</field>
    <time>00:00 - 13:00</time>
    <description>Insight Shield (info): Login during business hours — $(win.eventdata.targetUserName)</description>
    <group>insightshield_retail_baseline,authentication_success,business_hours,</group>
  </rule>

  <!-- Windows service started during business hours — baseline service activity -->
  <rule id="100051" level="3">
    <if_sid>61100</if_sid>
    <field name="win.system.eventID">^7036$</field>
    <field name="win.eventdata.param2">running</field>
    <time>00:00 - 13:00</time>
    <description>Insight Shield (info): Windows service started — $(win.eventdata.param1)</description>
    <group>insightshield_retail_baseline,service_change,</group>
  </rule>

  <!-- Windows Update install completed — patch-management baseline -->
  <rule id="100052" level="4">
    <if_sid>61100</if_sid>
    <field name="win.system.providerName">Microsoft-Windows-WindowsUpdateClient</field>
    <field name="win.system.eventID">^19$</field>
    <description>Insight Shield (info): Windows Update installed</description>
    <group>insightshield_retail_baseline,system_update,</group>
  </rule>

  <!-- USB storage device connected (Event 6416 + USBSTOR\Disk) — authorize check -->
  <rule id="100053" level="5">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^6416$</field>
    <match>USBSTOR</match>
    <description>Insight Shield (low): USB storage device connected — verify it is authorized</description>
    <group>insightshield_retail_baseline,usb_detection,</group>
  </rule>

  <!-- Local account password reset by administrator -->
  <rule id="100054" level="5">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4724$</field>
    <description>Insight Shield (low): Account password reset by an administrator — $(win.eventdata.targetUserName)</description>
    <group>insightshield_retail_baseline,account_management,password_change,</group>
  </rule>

  <!-- Scheduled task created — verify approved maintenance -->
  <rule id="100055" level="6">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4698$</field>
    <description>Insight Shield (low): Scheduled task created, verify it is approved — $(win.eventdata.taskName)</description>
    <group>insightshield_retail_baseline,scheduled_task,</group>
  </rule>

  <!-- Explicit credential use (e.g. RDP session start) during business hours -->
  <rule id="100056" level="6">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4648$</field>
    <time>00:00 - 13:00</time>
    <description>Insight Shield (low): Sign-in with explicit credentials (e.g. RDP) — $(win.eventdata.targetUserName)</description>
    <group>insightshield_retail_baseline,remote_access,</group>
  </rule>

</group>
