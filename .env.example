# Insight Shield Environment Variables
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to git.
#
# Round 3 note: after first boot, every service credential below moves into
# the encrypted api_keys / settings tables. Subsequent edits go through the
# Settings UI at /admin/settings — only FLASK_SECRET_KEY and ENCRYPTION_KEY
# stay env-driven post-bootstrap.
#
# Credential values are deliberately BLANK, not placeholder text. scripts/
# install.sh copies this file straight to .env, and the first-boot bootstrap
# skips empty values but happily imports non-empty junk — a "your-key-here"
# string would be stored as a live credential, flip bootstrap_complete, and
# make every later .env edit a no-op. Leave them empty.

# Master key for encrypting API credentials in the database. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DO NOT lose this key — every encrypted credential becomes unrecoverable
# without it. Back it up securely.
ENCRYPTION_KEY=

# AI Providers
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# AI model per provider — OVERRIDE knobs. Leave blank to use the valid defaults
# in config.py (Groq llama-3.3-70b-versatile, Gemini gemini-2.5-flash,
# OpenRouter meta-llama/llama-3.1-8b-instruct:free). Set one only when a slug is
# retired and its calls start returning HTTP 400 — that is what silently killed
# AI before (a dead hardcoded slug read as "rate limiting"). Free ':free'
# OpenRouter slugs drift most often.
GROQ_MODEL=
GEMINI_MODEL=
OPENROUTER_MODEL=

# Display label for the IT dashboard's primary-provider KPI tile. Match
# whatever you set as the first provider in the fallback chain.
PRIMARY_AI_LABEL=Groq

# IT recommender — a SECOND AI call per alert (IT-only investigation steps).
# OFF by default so it does not compete with the manager translation for the
# free-tier quota. Set to 1 to re-enable; even then it only runs for HIGH/
# CRITICAL alerts (config.AI_ENABLED_SEVERITIES). Leave blank to keep it off.
IT_RECOMMENDER_ENABLED=

# AI budget controls (all optional — shown with their defaults).
# AI_REPEAT_CAP: max live AI attempts per (rule, device) per 24 h. A noisy rule
#   otherwise burns the whole free-tier quota re-analysing the same alert; past
#   the cap it falls back to the static template and sibling reuse. 0 disables.
AI_REPEAT_CAP=5
# IT_REC_REUSE_WINDOW_MIN: reuse a recent recommendation from the same rule+device
#   instead of paying for a fresh call. 0 disables reuse.
IT_REC_REUSE_WINDOW_MIN=15
# IT_REC_BACKFILL_MIN: interval of the sweep that fills blank recommendations.
#   0 disables the sweep (set this when the providers are exhausted and the sweep
#   is only burning quota retrying rows that keep failing).
IT_REC_BACKFILL_MIN=10

# Telegram Bot — IT group (receives all MEDIUM+ alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram Bot — Manager (receives HIGH/CRITICAL + resolution notices only)
TELEGRAM_MANAGER_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# Gmail SMTP (use App Password, not Gmail password). Email is OFF unless
# EMAIL_ENABLED=1 — off also hides the Gmail card in Settings.
EMAIL_ENABLED=0
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Notification Recipients (contact-record fields only — SMS channel
# retired Round J; no longer read by any dispatch path).
MANAGER_PHONE=
IT_ADMIN_PHONE=
IT_ADMIN_EMAIL=

# Flask (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=

# Shared secret for /wazuh-webhook. REQUIRED — the webhook fails closed and
# returns 403 for every payload while this is unset (the IP allowlist alone is
# not enough, because remote_addr comes from a client-supplied X-Forwarded-For).
# Set the same value in the Wazuh integrator script so it sends
# `X-Webhook-Token: <this>`.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WAZUH_WEBHOOK_TOKEN=

# Wazuh API (optional — dashboard falls back to static device list if unavailable)
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=
# Unset = verify against the system trust store. A path = use that CA bundle
# (what a self-signed lab manager needs). 0/false/no/off = do not verify, which
# sends the API credentials over an unvalidated channel. Lab only.
WAZUH_API_VERIFY=

# First-boot passwords for the seeded admin / manager accounts. REQUIRED on a
# fresh database — db.seed_users_from_config() refuses to seed without them,
# because a published bootstrap password owns the IT_ADMIN role for the whole
# window between first boot and first login. Ignored once users is non-empty,
# so an existing install is unaffected by leaving them blank.
# Optional. Encrypts whole-database snapshots in backups/. Unset means the
# snapshots use ENCRYPTION_KEY, which is what existing installs do and keeps
# every .db.enc already on disk restorable. Setting it separates the two trust
# domains: the snapshots contain the encrypted credential rows, so one key for
# both means a single disclosure opens the credentials AND every historical
# copy of them. Keep this one somewhere the running app does not need it.
BACKUP_ENCRYPTION_KEY=

# Optional, rotation only. Set to the PREVIOUS value of the matching key and
# both are accepted for decryption while everything new is written under the
# current one — giving a window to re-encrypt without a flag day. Remove it
# once nothing is left under the old key; anything still encrypted under it
# stops decrypting at that point, which is the confirmation that you are done.
ENCRYPTION_KEY_OLD=
BACKUP_ENCRYPTION_KEY_OLD=

BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_MANAGER_PASSWORD=
