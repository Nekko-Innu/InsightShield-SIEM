# Environment variables — NEVER commit API keys
.env
.env.local
ai_api_model.txt

# Private keys and certificates
*.pem
*.key

# SQLite database, its write-ahead log, and encrypted backups. The -wal and
# -shm siblings exist whenever the app has the database open, so they will be
# sitting in the working tree during normal development.
*.db
*.db-shm
*.db-wal
*.db.enc
backups/

# Rotating app log
logs/
*.log

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/

# Dev-only seed script (its own docstring says "Not committed")
seed_dev_alerts.py

# PDF render samples — dev verification output, not source
pdf-samples/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# ── Local-only working files — not part of the deployable project ────────────
# Anything below is scratch, reference, or session output. It is useful while
# working on this box but must not be in the repo others clone to install.

# MemSearch plugin's local memory/index
.memsearch/

# Wazuh 4.8.2 upstream sources, pulled in only to read the rule-engine logic
*_4.8.2.c
# Stock Wazuh rule dump kept for lookups
wazuh_rules.txt

# Dashboard design mockups (not shipped; the real templates live in templates/)
*-mock.html
*-mock-proposed.html

# Penetration-test outputs — raw scans, captured cookies, dumped pages.
# Never publish: contains session data and is specific to one engagement.
pentest_release/

# Local diagnostic / incident write-ups kept on the host, not for distribution
docs/Live DIagnosis.md
docs/bugs and fixes.docx
